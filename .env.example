# Copier dans .env, remplir localement ; ne jamais publier .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mercasport
DB_USER=postgres
DB_PASSWORD=
PORT=3000

# Alternative pour PostgreSQL hébergé (prioritaire sur DB_*).
# Utiliser l’URL du fournisseur, avec ses paramètres TLS, sans désactiver les certificats.
# DATABASE_URL=postgresql://utilisateur:mot-de-passe@serveur:5432/mercasport?sslmode=verify-full

# PROF-02 : connexion et identification du profil.
# Generer une cle privee de 64 caracteres hexadecimaux, ne pas la publier.
AUTH_SECRET=
# En local uniquement : http://localhost:3000. En production : origine HTTPS exacte.
APP_ORIGIN=http://localhost:3000

# Facultatif, messagerie SSE : connexion PostgreSQL directe pour LISTEN (sans pooler).
# Sinon, le backend derive le hostname direct de DATABASE_URL pour Neon.
# MESSAGING_DATABASE_URL=
