{
  "name": "mercasport",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": { "node": "22.x" },
  "workspaces": ["backend"],
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build": "node scripts/build.js",
    "configure": "python3 scripts/configure-local.py",
    "test": "python3 tests/integration.py",
    "test:sql": "python3 database/tests/run.py",
    "test:registration": "node --test backend/registration/tests/register.test.js",
    "test:profile": "node --test tests/profile.test.js",
    "test:admin-users": "node --test tests/admin-users.test.js",
    "test:admin": "node --test tests/admin-users.test.js tests/admin-crud.test.js"
  },
  "dependencies": { "express": "^5.2.1" },
  "devDependencies": { "@electric-sql/pglite": "0.5.8" }
}
